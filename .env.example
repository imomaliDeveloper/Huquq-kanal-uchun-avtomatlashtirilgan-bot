# Telegram Bot Config
BOT_TOKEN=7123456789:AAFxxx...
CHANNEL_ID=@Huquq_study
ADMIN_ID=123456789

# AI Provider Config (gemini or openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy...
AI_MODEL=gemini-1.5-flash

# Image Generation Config
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=

# Scheduler Config
POST_INTERVAL_HOURS=1
TIMEZONE=Asia/Tashkent
AUTO_POST=true
ADMIN_APPROVAL=false

# Night Quiet Hours (23:00 to 07:00) & Peak Hours Mode
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=23
QUIET_HOURS_END=7
PEAK_HOURS_MODE=false

# Database URL for Prisma SQLite
DATABASE_URL="file:../data/legal_agent.db"
